# mock = bot chạy cục bộ để dev giao diện; polling = gọi API PHP (mặc định khi build production).
VITE_GATEWAY=mock
# Địa chỉ API PHP. Bỏ trống: dev (localhost) dùng http://127.0.0.1:8787/api_zingplay, còn lại dùng <origin>/api_zingplay.
VITE_API_URL=
# 1 = dùng long-poll (cần PHP bật long_poll trong config.php).
VITE_LONG_POLL=0
